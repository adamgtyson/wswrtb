# ---------------------------------------------------------------------------
# WSWRTB environment configuration. Copy to .env and fill in values.
# .env is git-ignored — NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Signing key for JWT session cookies. Minimum 32 characters.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# How many days a session cookie stays valid before re-login is required.
JWT_EXPIRY_DAYS=7

# "development" or "production".
# Controls the Secure flag on the session cookie:
#   development -> Secure OFF  (allows plain-http testing on the LAN)
#   production  -> Secure ON   (cookie only sent over HTTPS)
ENVIRONMENT=development

# Optional: override the SQLite database file path.
# Defaults to ./wswrtb.db in the project root if unset.
WSWRTB_DB_PATH=
