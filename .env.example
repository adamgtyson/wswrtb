# ---------------------------------------------------------------------------
# WSWRTB environment configuration. Copy to .env and fill in values.
# .env is git-ignored — NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Signing key for JWT session cookies. Minimum 32 characters.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# How many days a session cookie stays valid before re-login is required.
JWT_EXPIRY_DAYS=7

# "development" or "production".
# Controls the Secure flag on the session cookie:
#   development -> Secure OFF  (allows plain-http testing on the LAN)
#   production  -> Secure ON   (cookie only sent over HTTPS)
ENVIRONMENT=development

# Optional: override the SQLite database file path.
# Defaults to ./wswrtb.db in the project root if unset.
WSWRTB_DB_PATH=

# Comma-separated CORS origin whitelist (no wildcards — auth uses cookies).
# Development example below; PRODUCTION MUST set the real deployed domain(s), e.g.
#   ALLOWED_ORIGINS=https://wswrtb.example.com
ALLOWED_ORIGINS=http://localhost:8000

# Optional rate-limit overrides (SQLite-backed limiter). Defaults shown; tune as needed.
# Format: RATE_LIMIT_<ACTION> = max attempts, RATE_LIMIT_<ACTION>_WINDOW = seconds.
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REGISTER_WINDOW=3600
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_INVITE_CREATE=20
RATE_LIMIT_INVITE_CREATE_WINDOW=3600
