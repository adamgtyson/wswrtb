# ---------------------------------------------------------------------------
# WSWRTB environment configuration. Copy to .env and fill in values.
# .env is git-ignored — NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Signing key for JWT session cookies. Minimum 32 characters.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# How many days a session cookie stays valid before re-login is required.
JWT_EXPIRY_DAYS=7

# "development" or "production".
# Controls the Secure flag on the session cookie:
#   development -> Secure OFF  (allows plain-http testing on the LAN)
#   production  -> Secure ON   (cookie only sent over HTTPS)
ENVIRONMENT=development

# Optional: override the SQLite database file path.
# Defaults to ./wswrtb.db in the project root if unset.
WSWRTB_DB_PATH=

# Comma-separated CORS origin whitelist (no wildcards — auth uses cookies).
# Development example below; PRODUCTION MUST set the real deployed domain(s), e.g.
#   ALLOWED_ORIGINS=https://wswrtb.example.com
ALLOWED_ORIGINS=http://localhost:8000

# Optional rate-limit overrides (SQLite-backed limiter). Defaults shown; tune as needed.
# Format: RATE_LIMIT_<ACTION> = max attempts, RATE_LIMIT_<ACTION>_WINDOW = seconds.
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REGISTER_WINDOW=3600
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_INVITE_CREATE=20
RATE_LIMIT_INVITE_CREATE_WINDOW=3600

# ---------------------------------------------------------------------------
# Claude / AI cost controls (Session 3)
# ---------------------------------------------------------------------------

# Anthropic API key. Create it in a dedicated Console workspace with its own hard
# monthly spend cap. NEVER commit a real key — this file stays blank.
# Without it, AI endpoints fail loudly with a 503 (they never silently degrade).
ANTHROPIC_API_KEY=

# Model used for recommendations. Haiku 4.5 is the cost choice for short structured
# output; changing this changes cost — see the pricing constants in
# app/services/claude_service.py, which must be updated to match the model.
CLAUDE_MODEL=claude-haiku-4-5

# GLOBAL kill switch (US dollars). Before every Claude call the app sums today's
# est_cost_usd across ALL users (UTC day); at or over this, AI is refused for everyone
# until the day rolls over. Keep it well under the workspace's hard spend cap.
AI_DAILY_COST_CEILING_USD=5

# Per-calling-user AI request limits, counted from ai_usage rows in a trailing window.
# One request consumes one slot no matter how many members' profiles it combines.
AI_RATE_PER_HOUR=15
AI_RATE_PER_DAY=50

# Extra allowance for users on the free plan (everyone today — there is no billing yet).
# Enforced over a rolling 30-day window, not a calendar month.
FREE_TIER_MONTHLY_AI_REQUESTS=15

# Optional request-shape overrides. Max output tokens per Claude call, and the maximum
# length (characters) of a member's free-text recommendation prompt.
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_PROMPT_CHARS=1000
